RELAY_DEMO=1
RELAY_HOST=127.0.0.1
PORT=3000
RELAY_DATA=.relay

# 正式部署须设置 RELAY_DEMO=0，并配置以下项。
# RELAY_ORIGIN=https://relay.example.com
# RELAY_KEY=64位十六进制随机密钥
# RELAY_USERS=[{"tenant":"acme","id":"hr","name":"人力资源","role":"hr","email":"hr@example.com","passwordHash":"由口令生成脚本输出"}]
# DATABASE_URL=postgresql://relay:数据库密码@localhost:5432/relay
# POSTGRES_PASSWORD=与数据库连接串一致的密码
# RELAY_DOMAIN=relay.example.com
# RELAY_PAID_TENANTS=acme,example

# RELAY_AI_ENDPOINT=https://provider.example.com/v1/chat/completions
# RELAY_AI_API_KEY=模型凭证
# RELAY_AI_MODEL=模型名称
# RELAY_AI_JSON_OBJECT=0
# RELAY_AI_INPUT_RATE=2
# RELAY_AI_OUTPUT_RATE=8

# RELAY_S3_BUCKET=relay-private
# AWS_REGION=us-east-1
# RELAY_S3_ENDPOINT=https://s3.example.com
# AWS_ACCESS_KEY_ID=对象存储凭证
# AWS_SECRET_ACCESS_KEY=对象存储凭证
# RELAY_PDF_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# RELAY_PDF_FONT_FACE=NotoSansCJKsc-Regular
